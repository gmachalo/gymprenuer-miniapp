// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH (NextAuth v5 required tables) ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  username        String?   @unique
  displayName     String?
  walletAddress   String?   @unique
  mode            Mode      @default(SOLO)
  level           Int       @default(1)
  totalXp         BigInt    @default(0)
  offChainTokens  BigInt    @default(0)
  onChainSynced   Boolean   @default(false)
  onboardingDone  Boolean   @default(false)
  currentXp       Int       @default(100)  // 0–100 visible bar; spendable energy, not a reward
  overflowXp      Int       @default(0)    // XP above 100, spendable (pool capped at MAX_XP_ACCUMULATION)
  trainerEarningsMicro BigInt @default(0)  // pending trainer GYMFIT pay, in micro-units (100 000 micro = 1 GYMFIT)
  homeRecoveryUsedAt Json    @default("{}") // { bed?, chair?, fridge?: ISO datetime } — per-item cooldown for HomeScene recovery props
  gymAmenityUsedAt   Json    @default("{}") // { <amenity type>: ISO datetime } — per-amenity cooldown for GymScene amenities
  lastXpRegenAt   DateTime  @default(now())
  restUntil       DateTime?               // null = not resting
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  characters      Character[]
  workouts        Workout[]
  streak          Streak?
  ownedGyms       Gym[]           @relation("GymOwner")
  gymMemberships  GymMember[]
  gymCoOwnerships GymCoOwner[]
  rewards         Reward[]
  transactions    Transaction[]
  challenges      Challenge[]     @relation("ChallengeCreator")
  fitnessSyncs    FitnessSync[]
  fitnessLinks    FitnessConnection[]
  fitnessWorkouts FitnessWorkout[]
}

enum Mode {
  SOLO
  SOCIAL
}

// ─── CHARACTERS ───────────────────────────────────────────────────────────────

model Character {
  id                  String    @id @default(cuid())
  userId              String
  name                String
  bodyType            BodyType
  strength            Int       @default(10)
  stamina             Int       @default(10)
  discipline          Int       @default(10)
  metabolism          Int       @default(10)
  transformationStage Int       @default(0) // 0–5
  isActive            Boolean   @default(true)
  nftTokenId          String?
  createdAt           DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts        Workout[]
  fitnessWorkouts FitnessWorkout[]
}

enum BodyType {
  SKINNY
  AVERAGE
  OVERWEIGHT
}

// ─── WORKOUT PLANS ────────────────────────────────────────────────────────────

model WorkoutPlan {
  id            String      @id @default(cuid())
  name          String
  type          PlanType
  description   String?
  targetStats   Json        @default("{}")
  durationWeeks Int         @default(4)
  isSystem      Boolean     @default(true)
  createdBy     String?

  workouts Workout[]
}

enum PlanType {
  STRENGTH
  FAT_LOSS
  HYBRID
  CALISTHENICS
}

// ─── WORKOUTS ─────────────────────────────────────────────────────────────────

model Workout {
  id           String        @id @default(cuid())
  userId       String
  characterId  String?
  planId       String?
  source       WorkoutSource @default(IN_GAME)
  externalId   String?
  durationMins Int
  intensity    Intensity     @default(MEDIUM)
  adherencePct Decimal       @default(100) @db.Decimal(5, 2)
  xpEarned     Int           @default(0)
  tokensEarned BigInt        @default(0)
  fitnessBoost Decimal       @default(0) @db.Decimal(5, 4)
  completedAt  DateTime      @default(now())
  createdAt    DateTime      @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character?  @relation(fields: [characterId], references: [id])
  plan      WorkoutPlan? @relation(fields: [planId], references: [id])
}

enum WorkoutSource {
  IN_GAME
  API_SYNC
}

enum Intensity {
  LOW
  MEDIUM
  HIGH
}

// ─── STREAKS ──────────────────────────────────────────────────────────────────

model Streak {
  id               String    @id @default(cuid())
  userId           String    @unique
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastWorkoutAt    DateTime?
  streakFreezeCount Int      @default(0)
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── GYMS ─────────────────────────────────────────────────────────────────────

model Gym {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        GymType  @default(PLAYER)
  ownerId     String?
  reputation  Int      @default(0)
  memberCount Int      @default(0)
  maxMembers  Int      @default(50)
  monthlyFee  BigInt   @default(100)
  tier        Int      @default(1)   // 1–5
  nftTokenId  String?
  onChain     Boolean  @default(false)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User?        @relation("GymOwner", fields: [ownerId], references: [id])
  members    GymMember[]
  coOwners   GymCoOwner[]
  equipment  Equipment[]
  amenities  GymAmenity[]
  npcClients NpcClient[]
  challenges Challenge[]
}

enum GymType {
  SYSTEM
  PLAYER
}

// ─── GYM MEMBERS ─────────────────────────────────────────────────────────────

model GymMember {
  id       String     @id @default(cuid())
  gymId    String
  userId   String
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
}

enum MemberRole {
  MEMBER
  TRAINER
  CO_OWNER
}

// ─── GYM CO-OWNERS ───────────────────────────────────────────────────────────

model GymCoOwner {
  id           String  @id @default(cuid())
  gymId        String
  userId       String
  revenueShare Decimal @db.Decimal(5, 2)
  onChainShare Boolean @default(false)

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
}

// ─── EQUIPMENT ───────────────────────────────────────────────────────────────

model Equipment {
  id           String   @id @default(cuid())
  gymId        String
  name         String
  type         String
  level        Int      @default(1)
  purchaseCost BigInt
  upgradeCost  BigInt?
  capacity     Int      @default(5)
  statBonus    Json     @default("{}")
  nftTokenId   String?
  purchasedAt  DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  // One machine of each catalog type per gym — the buy route and the seed both
  // rely on this, and duplicates would render twice on the floor.
  @@unique([gymId, type])
}

// ─── GYM AMENITIES ────────────────────────────────────────────────────────────
// Refreshments, facilities and rooms the owner has bought. Standard fittings
// (the water dispenser and shower every gym has from tier 1) are implicit in
// the catalog and deliberately have no row here — see AMENITY_CATALOG.

model GymAmenity {
  id          String   @id @default(cuid())
  gymId       String
  type        String   // catalog key, see AMENITY_CATALOG in src/lib/game/engine.ts
  installCost BigInt   @default(0)
  installedAt DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, type])
  @@index([gymId])
}

// ─── NPC CLIENTS ─────────────────────────────────────────────────────────────

model NpcClient {
  id           String  @id @default(cuid())
  gymId        String
  name         String
  goal         String
  satisfaction Int     @default(50)
  spendingRate BigInt  @default(10)
  active       Boolean @default(true)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

// ─── REWARDS ─────────────────────────────────────────────────────────────────

model Reward {
  id          String     @id @default(cuid())
  userId      String
  type        RewardType
  baseAmount  BigInt
  bonusAmount BigInt     @default(0)
  fitnessBoost Decimal   @default(0) @db.Decimal(5, 4)
  totalAmount BigInt
  sourceId    String?
  claimed     Boolean    @default(false)
  onChainTx   String?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RewardType {
  WORKOUT
  GYM_INCOME
  CHALLENGE
  STREAK_BONUS
  REFERRAL
}

// ─── TRANSACTIONS ─────────────────────────────────────────────────────────────

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  type          TransactionType
  amount        BigInt
  balanceBefore BigInt
  balanceAfter  BigInt
  description   String?
  txHash        String?
  chainId       Int?
  createdAt     DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  EARN
  SPEND
  TRANSFER
  ON_CHAIN_CLAIM
  GYM_FEE
  EQUIPMENT_BUY
}

// ─── CHALLENGES ───────────────────────────────────────────────────────────────

model Challenge {
  id         String          @id @default(cuid())
  title      String
  type       ChallengeType
  creatorId  String
  gymId      String?
  prizePool  BigInt          @default(0)
  startAt    DateTime?
  endAt      DateTime?
  status     ChallengeStatus @default(PENDING)
  metadata   Json            @default("{}")
  createdAt  DateTime        @default(now())

  creator User @relation("ChallengeCreator", fields: [creatorId], references: [id])
  gym     Gym? @relation(fields: [gymId], references: [id])
}

enum ChallengeType {
  ONE_V_ONE
  GROUP
  GYM_VS_GYM
  COMMUNITY
}

enum ChallengeStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── FITNESS SYNC ─────────────────────────────────────────────────────────────

model FitnessSync {
  id           String    @id @default(cuid())
  userId       String
  syncDate     DateTime
  durationMins Int
  intensity    Intensity @default(MEDIUM)
  adherencePct Decimal   @db.Decimal(5, 2)
  streakCount  Int       @default(0)
  fitnessBoost Decimal   @default(0) @db.Decimal(5, 4)
  applied      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  provider FitnessProvider @default(MOCK)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, syncDate])
}

// ─── IMPORTED REAL-WORLD WORKOUTS ─────────────────────────────────────────────
// One row per session pulled from (or pushed by) the player's workout app. The
// externalId unique is the dedupe key: re-pulling an overlapping window can
// never award the same session's stats twice.

model FitnessWorkout {
  id           String          @id @default(cuid())
  userId       String
  characterId  String?
  provider     FitnessProvider
  externalId   String          // the session's id in the provider's system
  performedAt  DateTime
  durationMins Int
  intensity    Intensity       @default(MEDIUM)
  planType     PlanType        @default(HYBRID) // provider activity mapped onto a game plan type
  adherencePct Decimal         @default(100) @db.Decimal(5, 2)

  // Stat gain this session awarded the character
  gainStrength   Int @default(0)
  gainStamina    Int @default(0)
  gainDiscipline Int @default(0)
  gainMetabolism Int @default(0)

  // False when the session failed an anti-cheat threshold — kept for the audit
  // trail and to stop it being re-evaluated on the next pull.
  counted   Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, externalId])
  @@index([userId, performedAt])
}

// ─── FITNESS APP CONNECTION ───────────────────────────────────────────────────
// A link to the workout app the player actually trains with. The game pulls
// completed sessions from it and converts them into character stat gains, so
// real training is what pushes a character over the level-up stat floor.

model FitnessConnection {
  id             String          @id @default(cuid())
  userId         String
  provider       FitnessProvider
  externalUserId String?         // the player's id at the provider
  accessToken    String?         // stored server-side only, never returned to the client
  refreshToken   String?
  expiresAt      DateTime?       // access token expiry
  scope          String?
  connectedAt    DateTime        @default(now())
  lastSyncedAt   DateTime?       // watermark — only workouts after this are pulled
  lastError      String?
  active         Boolean         @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

enum FitnessProvider {
  MOCK
  STRAVA
  FITBIT
  GOOGLE_FIT
  APPLE_HEALTH
}
